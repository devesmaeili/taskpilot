# Firebase (Authentication)
# Create a project at https://console.firebase.google.com/
# Enable Authentication → Sign-in method → Google, GitHub, Microsoft, Apple, Email/Password
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: GitHub OAuth app client ID/secret are configured in the Firebase console, not here.
# Authorized domains must include localhost and your GitHub Pages host (e.g. devesmaeili.github.io).

# OpenRouter (ChatGPT, Claude, Gemini, and all free models) — https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# Telegram — username is public (landing connect). Token is server-only; never use VITE_ for the token.
VITE_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
